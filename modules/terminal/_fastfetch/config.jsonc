{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // $1 in nixos.txt = mauve, $2 = lavender.
    "type": "file",
    "source": "~/.config/fastfetch/nixos.txt",
    "color": {
      "1": "#cba6f7",
      "2": "#b4befe"
    }
  },
  "display": {
    "separator": "│ ",
    "color": {
      "keys": "#6e738d",
      "separator": "#9198ab"
    },
    "size": {
      "binaryPrefix": "si"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "{##cba6f7}\uf313 GIGI {##6e738d}── {##b4befe}NIXOS CATPPUCCIN EDITION"
    },
    "break",

    {
      "type": "title",
      "key": "\uf007 user ",
      "keyColor": "#c6a0f6",
      "format": "{##b7bdf8}{user-name}{##6e738d}@{##b7bdf8}{host-name}"
    },
    {
      "type": "os",
      "key": "\uf313 os   ",
      "keyColor": "#c6a0f6",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "\uf17c krnl ",
      "keyColor": "#c6a0f6",
      "format": "{sysname} {release}"
    },
    {
      "type": "uptime",
      "key": "\uf017 time ",
      "keyColor": "#c6a0f6",
      "format": "{?days}{days}d {?}{hours}h {minutes}m"
    },
    "break",

    {
      "type": "wm",
      "key": "\uf2d0 wm   ",
      "keyColor": "#b7bdf8",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "\uf120 sh   ",
      "keyColor": "#b7bdf8",
      "format": "{pretty-name}"
    },
    {
      "type": "terminal",
      "key": "\uf489 term ",
      "keyColor": "#b7bdf8",
      "format": "{pretty-name}"
    },
    "break",

    {
      "type": "cpu",
      "key": "\uf2db cpu  ",
      "keyColor": "#7dc4e4"
    },
    {
      "type": "gpu",
      "key": "\uf108 gpu  ",
      "keyColor": "#7dc4e4",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "\udb80\udf5b ram  ",
      "keyColor": "#91d7e3",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "\uf0a0 disk ",
      "keyColor": "#91d7e3",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
    },
    "break",

    {
      "type": "custom",
      "format": "            \u001b[38;2;91;96;120m\uf1b0  \u001b[38;2;183;189;255m\uf1b0  \u001b[38;2;195;157;240m\uf1b0  \u001b[38;2;245;189;230m\uf1b0  \u001b[38;2;240;198;198m\uf1b0  \u001b[38;2;138;173;244m\uf1b0  \u001b[38;2;145;215;227m\uf1b0  \u001b[38;2;202;211;245m\uf1b0 "
    }
  ]
}
